# ── Vite build-time env (web/.env.production — Vercel "VITE_" vars) ──
# These are PUBLIC (baked into the JS bundle) — never put secrets here.

# same addresses as server, prefixed VITE_ so the frontend can write txs directly
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org
VITE_AGENT_REGISTRY_ADDRESS=
VITE_POLICY_ENGINE_ADDRESS=
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Privy app id (public) — same value as server PRIVY_APP_ID; set it to enable
# Privy login (without it the app falls back to SIWE wallet sign-in)
VITE_PRIVY_APP_ID=
