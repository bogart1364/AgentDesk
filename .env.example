# ---------- AgentDesk server env (Vercel project settings or server/.env.local) ----------

# Base Sepolia --- required for chain mode
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
AGENT_REGISTRY_ADDRESS=
POLICY_ENGINE_ADDRESS=
# first block of your deployment --- makes event scans instant (printed by deploy.js if set)
DEPLOY_BLOCK=
# eth_getLogs is chunked into 200-block windows (public RPC hard cap).
# LOG_MAX_WINDOWS limits how many windows one query scans: 600 x 200 = 120k blocks.
# Raise it if your deployment is older than ~2.5 days of blocks (a warning is logged).
LOG_MAX_WINDOWS=600
# Live-feed window in blocks. 0 = scan everything from DEPLOY_BLOCK (demo-friendly,
# slower first load); set e.g. 4000 for a fast "recent activity" feed in production.
FEED_LOOKBACK_BLOCKS=0

# USDC on Base Sepolia (default set, override only if changed)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Auth --- REQUIRED in production, MUST be a long random string
# the server refuses to boot in production without it (forgeable JWTs otherwise)
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
APP_DOMAIN=agentdesk.xyz

# CORS allowlist --- comma-separated origins or bare hosts (empty = reflect any origin, dev only)
# e.g. CORS_ORIGINS=agentdesk.xyz,https://agentdesk.vercel.app,http://localhost:5173
CORS_ORIGINS=

# Privy login (email / social / wallet modal) --- from dashboard.privy.io
# both required; without them the app falls back to plain SIWE wallet sign-in
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# x402 settlement --- your receiving address + facilitator
PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator

# ---------- Base Verify (https://docs.base.org/sdks/base-verify) ----------
# Integration 1 --- Verify Social Accounts (backend-enforced, needs a key from
# https://forms.gle/6L4hWAHkojYcefz27). Without it the /api/verify/social endpoint
# refuses in production (501) and serves a clearly-flagged demo identity in dev.
BASE_VERIFY_SECRET_KEY=
BASE_VERIFY_API_URL=https://verify.base.dev/v1
BASE_VERIFY_APP_URL=https://verify.base.dev
#
# Integration 2 --- Verify Users Onchain (contract-enforced, no key): the SignerRegistry
# address is baked into the AgentRegistry constructor at deploy time, and the agent's
# policy (provider + conditions) is stored on-chain, e.g. coinbase + coinbase_one_active eq true.
# Set this before re-deploying; it is what AgentRegistry hands to the real registry.
BASE_VERIFY_SIGNER_REGISTRY=0x4f15593fbF7e3491d15080e1610E7AF8deBA1a02

# Deployer key --- ONLY used by contracts/scripts/deploy.js (never set on Vercel)
# DEPLOYER_PRIVATE_KEY=
